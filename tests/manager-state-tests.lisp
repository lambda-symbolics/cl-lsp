(in-package #:cl-lsp)

(-> test-lsp-manager-state () boolean)
(defun test-lsp-manager-state ()
  "Exercise empty caching, failed-load retry, non-starting status and typed no-match."
  (let ((manager (make-instance 'lsp-manager))
        (calls 0))
    (flet ((empty-loader () (incf calls) nil))
      (tests--assert (null (getf (lsp-manager-status manager) :loaded-p)) "status is non-loading")
      (dotimes (index 2)
        (declare (ignorable index))
        (tests--assert (null (lsp-manager-configurations-load manager #'empty-loader))
                       "empty configurations"))
      (tests--assert (= calls 1) "empty configurations are cached")
      (lsp-manager-close manager)
      (handler-case
          (lsp-manager-configurations-load
           manager (lambda () (error 'lsp-error :message "loader failure")))
        (lsp-error () nil))
      (tests--assert (not (lsp-manager-loaded-p manager)) "failed loader remains retryable")
      (lsp-manager-configurations-load manager #'empty-loader)
      (tests--assert (= calls 2) "close invalidates cache"))
    (with-test-directory (root)
      (let* ((path (merge-pathnames "example.txt" root))
             (client (lsp-client-tests--client root))
             (configuration (lsp-client-configuration client)))
        (setf (lsp-manager-configurations manager) (list configuration)
              (gethash "test" (lsp-manager-clients manager)) client)
        (let* ((status (lsp-manager-status manager))
               (row (first (getf status :clients))))
          (tests--assert (and (getf status :loaded-p)
                              (equal "test" (getf row :server))
                              (equal root (getf row :root))
                              (not (getf row :live-p))) "status observes stopped client")
          (setf (first (getf status :configurations)) nil
                (getf row :server) "changed")
          (tests--assert (eq configuration (first (lsp-manager-configurations manager)))
                         "status collections are independent"))
        (setf (lsp-manager-configurations manager) nil)
        (tests--assert
         (handler-case (progn (lsp-manager-map-file manager path (constantly nil)) nil)
           (lsp-no-matching-server (condition)
             (equal path (lsp-no-matching-server-path condition))))
         "no matching server has a typed pathname-bearing condition")
        (lsp-manager-close manager))))
  t)
