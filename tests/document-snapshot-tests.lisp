(in-package #:cl-lsp)

;;;; -- Frozen Document and Session Freshness --

(-> test-lsp-document-snapshots () null)
(defun test-lsp-document-snapshots ()
  "Exercise frozen text and URI-local freshness across document and session changes."
  (let* ((client   (lsp-client-tests--client #p"/"))
         (uri      "file:///a.txt")
         (other    "file:///b.txt")
         (document (make-instance 'lsp-document :path #p"/a.txt" :text (copy-seq "old"))))
    (setf (gethash uri (lsp-client-documents client)) document)
    (let* ((snapshot (lsp-client-document-snapshot client))
           (stamp    (nth-value 3 (funcall snapshot uri)))
           (absent   (nth-value 3 (funcall snapshot other)))
           (session  (lsp-client-session-snapshot client)))
      (tests--assert (lsp-client-snapshot-current-p client stamp :uri uri) "captured URI is current")
      (tests--assert (lsp-client-snapshot-current-p client absent :uri other) "absent URI is current")
      (setf (char (lsp-document-text document) 0) #\n)
      (tests--assert (equal (funcall snapshot uri) "old") "frozen text is independently owned")
      (setf (gethash other (lsp-client-documents client))
            (make-instance 'lsp-document :path #p"/b.txt" :text ""))
      (tests--assert (not (lsp-client-snapshot-current-p client absent :uri other))
                     "subsequently opening an absent URI invalidates its stamp")
      (tests--assert (lsp-client-snapshot-current-p client stamp :uri uri)
                     "opening an unrelated URI preserves the addressed stamp")
      (let ((empty (lsp-client-document-snapshot client)))
        (tests--assert (and (equal (funcall empty other) "")
                           (eq (nth-value 2 (funcall empty other)) ':file))
                       "empty text is a present document"))
      (incf (lsp-document-version document))
      (tests--assert (not (lsp-client-snapshot-current-p client stamp :uri uri))
                     "version advancement invalidates the addressed stamp")
      (setf (gethash uri (lsp-client-documents client))
            (make-instance 'lsp-document :path #p"/a.txt" :text "old"))
      (tests--assert (not (lsp-client-snapshot-current-p client stamp :uri uri))
                     "reopening at the original version has a distinct identity")
      (tests--assert (lsp-client-snapshot-current-p client session)
                     "document changes preserve session identity")
      (lsp-client-close client)
      (tests--assert (not (lsp-client-snapshot-current-p client session))
                     "closing even a transportless client invalidates the session")
      (let ((session (lsp-client-session-snapshot client)))
        (setf (lsp-client-transport client) (gensym "REPLACEMENT-"))
        (tests--assert (not (lsp-client-snapshot-current-p client session))
                       "transport replacement invalidates the session")
        (setf (lsp-client-transport client) nil))))
  nil)
